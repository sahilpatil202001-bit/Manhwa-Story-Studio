# Environment variables for Manhwa Story Studio
# Copy this file to .env and configure secrets if using paid or cloud services

# Optional TTS API Keys (if using third-party paid providers like ElevenLabs, Azure, or OpenAI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia
OPENAI_API_KEY=your_openai_api_key_here

# Local, free vision LLM via Ollama (optional)
# Set LLM_PROVIDER=ollama to use only the local model (no cloud API calls).
# Or leave LLM_PROVIDER=gemini and set OLLAMA_FALLBACK=1 to use Ollama after Gemini fails.
LLM_PROVIDER=gemini
OLLAMA_FALLBACK=0
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_NUM_CTX=16384

# Default local paths or overrides
STUDIO_FFMPEG_PATH=
STUDIO_FFPROBE_PATH=
STUDIO_LOG_LEVEL=INFO
